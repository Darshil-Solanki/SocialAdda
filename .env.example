# SocialAdda local settings.
#
# Copy this file to .env and run the project. These values start it in DEVELOPMENT mode:
#   cp .env.example .env
#   python manage.py migrate
#   python manage.py runserver
#
# .env is read by python-dotenv (see SocialAdda/settings.py). It is git-ignored, so never commit it.
# Variables already set in your shell or your platform's secret store take precedence over this file.
# For production, do not ship this file: set the production values in the environment instead
# (see docs/demo.md, part A3).

# ---- Mode -----------------------------------------------------------------
# 1 = development (default in code). Debug pages on, insecure dev secret key allowed, HTTP allowed.
DJANGO_DEBUG=1

# Leave empty in development: a built-in development key is used.
# Production (DJANGO_DEBUG=0) refuses to start without a real value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database -------------------------------------------------------------
# Empty POSTGRES_DB = SQLite file (db.sqlite3) in the project folder. Fine for development.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Redis (chat, live notifications, Celery queue, feed index, cache) ----
REDIS_URL=redis://localhost:6379
# Only used when CACHE_BACKEND=redis; the default in development is in-memory.
CACHE_BACKEND=locmem

# ---- Media files ----------------------------------------------------------
# local = files in the media/ folder. s3 = S3-compatible bucket (AWS, MinIO).
MEDIA_STORAGE=local
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CUSTOM_DOMAIN=

# ---- Email ----------------------------------------------------------------
# Development prints emails to the terminal instead of sending them.
EMAIL_BACKEND=SocialAdda.mail.ReadableConsoleEmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="SocialAdda Team <noreply@example.com>"

# Base URL of the Next.js site, used to build password-reset links.
FRONTEND_URL=http://localhost:3000

# ---- Feed index -----------------------------------------------------------
# FEED_REDIS_URL defaults to REDIS_URL database 2. Uncomment to change it.
# FEED_REDIS_URL=redis://localhost:6379/2
FEED_MAX_ITEMS=800
FEED_CELEBRITY_FOLLOWERS=500

# ---- Rate limits and proxies ----------------------------------------------
AUTH_RATE=10/minute
# Set to 1 only when the Next.js server sits in front of Django.
# DJANGO_NUM_PROXIES=1

# ---- HTTPS and proxy (production only; ignored in development) -------------
# DJANGO_HTTPS=1
# DJANGO_SSL_REDIRECT=1
# DJANGO_BEHIND_PROXY=1
# DJANGO_HSTS_SECONDS=3600
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-site.example.com

# ---- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_FORMAT=json

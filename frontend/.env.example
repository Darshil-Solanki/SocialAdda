# SocialAdda frontend settings for development.
#
# Copy to .env.local (Next.js reads .env.local automatically and never commits it):
#   cp .env.example .env.local
#   npm run dev
#
# Where Django runs. Next.js proxies /api/v1 and /media here (server-side only).
BACKEND_URL=http://localhost:8000

# Where the browser opens WebSockets. Read at build time, so restart after changing it.
NEXT_PUBLIC_WS_URL=ws://localhost:8000
